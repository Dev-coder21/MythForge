# MythForge backend settings. Copy to backend/.env (git-ignored) and fill in.
# Everything here is free: no billing is needed for any of these.

# Which LLM to try first: gemini | groq | ollama. Others with credentials are fallbacks.
LLM_PROVIDER=gemini

# Google AI Studio free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Groq free tier: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Optional local model via Ollama (https://ollama.com), e.g. llama3.1:8b. Leave empty to skip.
OLLAMA_MODEL=
# OLLAMA_URL=http://localhost:11434

# Wikimedia asks every client for contact info in its User-Agent (an email or a URL).
# Without it Wikipedia answers 403.
HTTP_CONTACT=
